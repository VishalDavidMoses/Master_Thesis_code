def rate_coefficient_plot(dictionary, j_init, j_final):
    
    temperature_list = []
    thounsand_by_temperature_list = []
    
    inel_rate_coefficient_list = []
    inel_log_rate_coefficient_list =[]
    
    cplx_rate_coefficient_list = []
    cplx_log_rate_coefficient_list =[]
    
    initial_rotation = f"j_{j_init}"
    final_rotation = f"j_{j_final}"
    
    title = f"{initial_rotation}->{final_rotation}"
    
    for number in np.arange(50,1001):
        temperature = int(number)
        temperature_list.append(temperature)
        inverse_temp = 1000/temperature
        thounsand_by_temperature_list.append(inverse_temp)
        
        inel_rate_coefficient = dictionary[temperature][initial_rotation][final_rotation]["inel_collision"]
        inel_rate_coefficient_list.append(inel_rate_coefficient)
        log_of_inel_rate_coeff = math.log(inel_rate_coefficient)
        inel_log_rate_coefficient_list.append(log_of_inel_rate_coeff)
        
        cplx_rate_coefficient = dictionary[temperature][initial_rotation][final_rotation]["cplx_formation"]
        cplx_rate_coefficient_list.append(cplx_rate_coefficient)
        log_of_cplx_rate_coeff = math.log(cplx_rate_coefficient)
        cplx_log_rate_coefficient_list.append(log_of_cplx_rate_coeff)
    
    
    inel_rate_coefficient_y_ticks = inel_log_rate_coefficient_list
    inel_rate_coefficient_y_values = inel_rate_coefficient_list
    
    temperature_x_ticks = thounsand_by_temperature_list
    temperature_x_label = temperature_list
    
    fig, ax = plt.subplots(figsize=(12, 6))
    
    ax.xaxis.set_major_locator(MaxNLocator(10))  # max 10 ticks
    ax.yaxis.set_major_locator(MaxNLocator(8))   # max 8 ticks
    
    plt.plot(temperature_x_ticks, inel_rate_coefficient_y_ticks, label= title, color='blue', marker='o', linestyle='-')
    
    plt.xlabel("Temperature 1000/T")  # Label for the x-axis
    plt.ylabel("Rate Coefficients for inelastic collisions ln(k(T))")  # Label for the y-axis
    plt.title(f"{title} inelastic collisions")  # Title for the plot
    
    plt.savefig(f"C:/Temporary_important_folder_1/Thesis_Time/images/temporary_rate_coefficients_folder/{initial_rotation}_to_{final_rotation}_inelastic_rate_coefficients.png")
    plt.legend()
    plt.show()
    
    cplx_rate_coefficient_y_ticks = cplx_log_rate_coefficient_list
    cplx_rate_coefficient_y_values = cplx_rate_coefficient_list
    
    fig, ax = plt.subplots(figsize=(12, 6))
    
    
    ax.xaxis.set_major_locator(MaxNLocator(10))  # max 10 ticks
    ax.yaxis.set_major_locator(MaxNLocator(8))   # max 8 ticks
    
    plt.plot(temperature_x_ticks, cplx_rate_coefficient_y_ticks, label= title, color='blue', marker='o', linestyle='-')
    
    plt.xlabel("Temperature 1000/T")  # Label for the x-axis
    plt.ylabel("Rate Coefficients for complex forming collisions ln(k(T))")  # Label for the y-axis
    plt.title(f"{title} complex forming collisions")  # Title for the plot
    
    plt.savefig(f"C:/Temporary_important_folder_1/Thesis_Time/images/temporary_rate_coefficients_folder/{initial_rotation}_to_{final_rotation}_cplx_rate_coefficients.png")
    plt.legend()
    plt.show()

