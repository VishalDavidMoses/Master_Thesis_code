ten_exp = 10**(-3)
k_B = 8.314462618 * ten_exp

ten_to_minus_4 = 10**(-4)
pi_mu = 3.1416 * 9.69697 * ten_to_minus_4

eight_by_pi_mu = 8/pi_mu

eight_by_pi_mu_power = eight_by_pi_mu**(0.5)

rate_coefficients_dict = {} # cs_w_E_colls_dict

for k, temperature in enumerate(np.arange(10,2001)):
    temp = int(temperature)
    rate_coefficients_dict[temp]={}
    
    k_B_T_part = k_B * temp
    
    one_by_k_B_T = 1/k_B_T_part

    one_by_k_B_T_power = one_by_k_B_T**(1.5)
    
    pre_int_factor = eight_by_pi_mu_power * one_by_k_B_T_power
    
    for i, initial_rotataion in enumerate(initial_rotational_level_list):
        
        initial_rotation_key = f"j_{initial_rotataion}"
        rate_coefficients_dict[temp][initial_rotation_key] = {}
        
        for j, final_rotation in enumerate(final_rotations_list):
            
            final_rotation = f"j_{final_rotation}"
            rate_coefficients_dict[temp][initial_rotation_key][final_rotation] = {}
            
            temporary_inel_list = copy.deepcopy(temperature_dict[temp][initial_rotation_key][final_rotation]["inel_collision"])
            temporary_cplx_frmtn_list = copy.deepcopy(temperature_dict[temp][initial_rotation_key][final_rotation]["cplx_formation"])
            
            temporary_inel_list_sum = sum(temporary_inel_list)
            temporary_cplx_frmtn_list_sum = sum(temporary_cplx_frmtn_list)
            
            rate_coefficient_inel = pre_int_factor * temporary_inel_list_sum
            rate_coefficient_cplx = pre_int_factor * temporary_cplx_frmtn_list_sum
            
            rate_coefficients_dict[temp][initial_rotation_key][final_rotation]["inel_collision"]=rate_coefficient_inel
            rate_coefficients_dict[temp][initial_rotation_key][final_rotation]["cplx_formation"]=rate_coefficient_cplx

