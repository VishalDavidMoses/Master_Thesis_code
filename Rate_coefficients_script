initial_rotational_level_list = [1,5,11,15,21]

ten_exp = 10**(-3)
k_B = 8.314462618 * ten_exp #kJ mol^-1 K^-1
temperature_dict = {}
discrete_integral_values_dict = {} # discrete_integral_values_dict
for l, temperature in enumerate(np.arange(10,2001)):
    temp = float(temperature)
    k_B_T_part = k_B * temp
    temperature_dict[temp] = {}
    for j, initial_rotataion in enumerate(initial_rotational_level_list):
        
        initial_rotation_key = f"j_{initial_rotataion}"
        temperature_dict[temp][initial_rotation_key] = {}
        
        for k, final_rotation in enumerate(final_rotations_list):
            
            final_rotation = f"j_{final_rotation}"
            temperature_dict[temp][initial_rotation_key][final_rotation] = {}
            
            
            temporary_inel_dict = copy.deepcopy(cross_sections_dictionary[initial_rotation_key][final_rotation]["inel_collision"])
            temporary_cplx_frmtn_dict = copy.deepcopy(cross_sections_dictionary[initial_rotation_key][final_rotation]["cplx_formation"])
            
            temperature_dict[temp][initial_rotation_key][final_rotation]["inel_collision"]=[]
            temperature_dict[temp][initial_rotation_key][final_rotation]["cplx_formation"]=[]
            
            for i, collisional_energy in enumerate(collisional_energy_list):
                
                
                if collisional_energy_list[i] != collisional_energy_list[-1]:
                    
                    i_plus_one = i + 1
                    E_coll_key_plus_one = collisional_energy_list[i_plus_one]
                    
                    x = collisional_energy * 4.184 #kJ mol^-1
                    x_plus_one_index = collisional_energy_list[i_plus_one] 
                    x_plus_one = x_plus_one_index * 4.184 #kJ mol^-1
                    
                    negative_x = -x
                    exp_part_x = negative_x/k_B_T_part
                    exponent_x = math.exp(exp_part_x)
                    
                    negative_x_plus_one = -x_plus_one
                    exp_part_negative_x_plus_one = math.exp(negative_x_plus_one)
                    exponent_negative_x_plus_one = exp_part_negative_x_plus_one/k_B_T_part
                    
                    f_x_cs_inel = temporary_inel_dict[collisional_energy]
                    f_x_plus_one_cs_inel = temporary_inel_dict[E_coll_key_plus_one]
                    
                    f_x_cs_cplx = temporary_cplx_frmtn_dict[collisional_energy]
                    f_x_plus_one_cs_cplx = temporary_cplx_frmtn_dict[E_coll_key_plus_one]
                    
                    g_x_cs_inel = f_x_cs_inel * x * exponent_x
                    g_x_plus_one_cs_inel = f_x_plus_one_cs_inel * x_plus_one * exponent_negative_x_plus_one
                    
                    addition_part_inel = g_x_cs_inel + g_x_plus_one_cs_inel
                    first_part_inel = addition_part_inel/2
    
                    g_x_cs_cplx = f_x_cs_cplx * x * exponent_x
                    g_x_plus_one_cs_cplx = f_x_plus_one_cs_cplx * x_plus_one * exponent_negative_x_plus_one
                    
                    addition_part_cplx = g_x_cs_cplx + g_x_plus_one_cs_cplx
                    first_part_cplx = addition_part_cplx/2
                    
                    second_part = x_plus_one - x
                    
                    multiplication_inel = first_part_inel * second_part
                    
                    multiplication_cplx = first_part_cplx * second_part
            
                    temperature_dict[temp][initial_rotation_key][final_rotation]["inel_collision"].append(multiplication_inel)
                    temperature_dict[temp][initial_rotation_key][final_rotation]["cplx_formation"].append(multiplication_cplx)
                    
